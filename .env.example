# Variables de la raíz: las lee docker-compose.yml para levantar el stack local.
# Copiá este archivo a .env y cambiá lo que necesites. Todas tienen un default
# en el compose, así que `docker compose up` funciona sin crear este archivo.
#
# Los secretos de la API (Google, JWT, OpenRouter, Mercado Pago) van en
# api/.env, no acá: la tabla completa está en el README.

# --- Base de datos (servicio db del compose) ---
# Si la contraseña tiene caracteres raros (@ : / ?), escribila percent-encoded:
# terminan adentro de la DATABASE_URL que arma el compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trato

# --- Frontend ---
# Se inlinea en el bundle durante el build, así que es el origen desde el que
# el browser ve la API, no el nombre del servicio de la red interna.
NEXT_PUBLIC_API_URL=http://localhost:4000
