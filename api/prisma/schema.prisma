// Esquema de Trato.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // La URL de conexión vive en prisma.config.ts (Prisma 7).
}

/// Titular de una cuenta. Se entra con Google o sólo con WhatsApp: por eso
/// `googleId`, `email` y `phoneNumber` son opcionales. Un usuario sin ninguno
/// de los tres es un alta por WhatsApp que todavía no escaneó el QR, y la
/// purga diaria lo borra (ver retention.rules.ts).
model User {
  id        String  @id @default(cuid())
  googleId  String? @unique
  email     String? @unique
  name      String?
  avatarUrl String?

  /// Número de WhatsApp vinculado (sin '+'). Identifica a las cuentas creadas
  /// sólo con WhatsApp y permite entrar con un código mandado al chat propio.
  phoneNumber String? @unique

  /// "google" | "local" — dónde vive la agenda. "local" es la tabla Evento.
  /// Explícito a propósito: un usuario de Google que perdió el refresh token
  /// no tiene que pasar en silencio a la agenda local.
  calendario String @default("google")

  /// Contraseña para entrar con número de WhatsApp (scrypt, ver
  /// auth/password.ts). Nunca en claro. Las cuentas de Google no la usan.
  passwordHash String?

  /// Versión de las sesiones: viaja en el JWT (`sv`) y `JwtStrategy` rechaza
  /// los que no coinciden. Subirla cierra todas las sesiones abiertas: se hace
  /// al cambiar o recuperar la contraseña y al cerrar sesión.
  sesionVersion Int @default(0)

  /// Refresh token de Google cifrado con AES-256-GCM. Nunca se expone por la API.
  googleRefreshToken String?

  /// Horario de atención del asistente (LAU-29), igual para agenda y ventas.
  /// Con `horarioAtencionActivo` en false atiende siempre (el default de las
  /// cuentas de antes); en true no inicia atenciones fuera de `horarioAtencion`
  /// ([{ dia, desde, hasta }]) leído en `zonaHoraria` (IANA). Las franjas se
  /// conservan al desactivarlo. Forma y reglas en src/horario-atencion/.
  horarioAtencionActivo Boolean @default(false)
  horarioAtencion       Json    @default("[]")
  /// Sólo para el horario de atención: la agenda y las ventas siguen en Buenos Aires.
  zonaHoraria           String  @default("America/Argentina/Buenos_Aires")

  /// Recorridos guiados que la cuenta ya vio (o salteó), por pantalla. El
  /// catálogo de claves vive en src/auth/tutoriales.ts.
  tutorialesVistos String[] @default([])

  whatsappSession   WhatsappSession?
  agent             Agent?
  conversaciones    Conversation[]
  suscripcion       Subscription?
  eventos           Evento[]
  codigosAcceso     CodigoAcceso[]
  productos         Producto[]
  descuentos        Descuento[]
  imagenesProducto  ImagenProducto[]
  ventas            Venta[]
  cuentaMercadoPago CuentaMercadoPago?
  notificaciones    Notificacion[]
  sugerencias       SugerenciaMejora[]
  condicionesPago   CondicionesPago?
  etapasChat        EtapaChat[]
  interesProductos  InteresProducto[]
  preguntasChat     PreguntaChat[]
  configEnvios      ConfiguracionEnvios?
  zonasEnvio        ZonaEnvio[]
  consultasEnvio    ConsultaEnvioSinResolver[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Sesión de WhatsApp (Baileys) vinculada a un usuario. Un usuario vincula un
/// único número por ahora, de ahí el 1:1.
model WhatsappSession {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// `{ creds }` de Baileys serializado con BufferJSON y cifrado con
  /// AES-256-GCM (token-crypto.ts), igual que googleRefreshToken. Las claves
  /// de Signal viven aparte, una por fila en WhatsappClave. Una fila de antes
  /// de LAU-18 trae `{ creds, keys }` entero: se parte en filas la primera vez
  /// que se carga (whatsapp-auth-state.ts).
  authState String

  claves WhatsappClave[]

  /// Número vinculado (sin '+'), recién disponible cuando abre la conexión.
  phoneNumber String?

  /// Espejo de creds.registered: si es true, al reiniciar la API se reconecta
  /// esta sesión sin pedir un QR nuevo.
  registered Boolean @default(false)

  linkedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Una clave de Signal de una sesión de WhatsApp (pre-keys, sesiones con cada
/// contacto, sender keys, app-state…). Antes iban todas en un solo blob que se
/// reescribía entero en cada mensaje; así cada `keys.set` toca sólo las filas
/// que cambiaron. Cuelga de la sesión y no del usuario: todo lo que borra la
/// sesión (desvincular, un QR vencido, la baja de la cuenta) se lleva sus claves.
model WhatsappClave {
  userId String
  sesion WhatsappSession @relation(fields: [userId], references: [userId], onDelete: Cascade)

  /// Tipo de clave de Baileys (`SignalDataTypeMap`): "pre-key", "session"…
  categoria String
  /// Id de la clave dentro de su categoría.
  clave     String
  /// El valor serializado con BufferJSON y cifrado con AES-256-GCM, uno por uno.
  valor     String

  updatedAt DateTime @updatedAt

  @@id([userId, categoria, clave])
}

/// Config del agente personalizado de un usuario, generada por el meta-agente
/// (api/src/agents) a partir de los cinco datos que carga en /contanos. Un
/// usuario tiene un único agente; volver a generar lo pisa.
model Agent {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "comercio" | "consultorio" | "reuniones" | "visitas" | "personal" | "otro"
  tipoUso String

  /// "agenda" | "ventas" — qué hace el asistente, y con eso qué grafo lo
  /// atiende. Es el discriminador y no `tipoUso`: hay agentes guardados con
  /// `tipoUso: 'comercio'` que son bots de turnos y tienen que seguir siéndolo.
  tipoAsistente String @default("agenda")

  /// Ya no la escribe el usuario: la arma el backend con los campos de abajo
  /// (construirDescripcion en agents.service.ts) y es lo que ve el meta-agente.
  descripcion String

  /// "persona" | "negocio" — define cómo se presenta el asistente.
  tipoTitular String @default("negocio")

  /// Nombre de la persona o del negocio que atiende.
  nombreTitular String @default("")

  /// Nombre con el que el asistente saluda por WhatsApp.
  nombreBot String @default("Tati")

  /// Franja horaria de atención, "HH:MM" en America/Argentina/Buenos_Aires.
  /// El runtime no agenda nada fuera de esta franja.
  horaDesde String @default("09:00")
  horaHasta String @default("18:00")

  /// [{ nombre: string, duracionMin: number, precio?: number, capacidad?: number,
  /// horarios?: [{ dia: "lun"…"dom", hora: "HH:MM" }] }] — tipos de turno que toma.
  /// Con `capacidad` es un turno grupal: varias personas en sus horarios fijos
  /// (api/src/agents/turnos-grupales.ts).
  tiposEvento Json @default("[]")

  /// System prompt generado, usado por el runtime conversacional (api/src/conversation).
  systemPrompt String

  /// Subconjunto de agent-catalog.ts que el agente tiene habilitado.
  allowedActions String[]

  /// Mensajes que el dueño escribió a mano en /asistente:
  /// { [clave]: { modo: "auto" | "propio", texto: string } }. Las claves y sus
  /// datos están en src/agents/mensajes.rules.ts; lo que falta queda en "auto".
  mensajes Json @default("{}")

  /// Dónde se atiende. Ventas: el local a la calle del comercio, si tiene.
  /// { tieneLocal, direccion?, enlaceUbicacion?, horarios: [{ dia, desde, hasta }], retiroEnLocal }.
  /// Agenda (LAU-17): { tieneLocal, lugar: "local" | "casa", direccion, enlaceUbicacion? }
  /// (tieneLocal false = sin lugar fijo). Null = nunca lo cargó (el asistente
  /// deriva esas consultas al dueño). La forma y sus reglas están en src/agents/local.ts.
  local Json?

  /// Modelo de OpenRouter usado para generar esta config. Null si se generó
  /// con la plantilla determinista (ver `templateVersion`); se conserva tal
  /// cual en los agentes generados por IA antes de este campo existir.
  model String?

  /// Versión de la plantilla determinista (agent-template.ts) que generó
  /// esta config. Null en agentes generados por IA antes de este campo.
  templateVersion Int?

  /// Sólo ventas: el comercio hace envíos. El asistente pregunta "¿envío o
  /// retiro?" y pide los datos de `datosCliente` sólo si es con envío.
  haceEnvios Boolean @default(false)

  /// Sólo ventas: qué datos le pide el asistente al cliente antes de crear el
  /// pedido. [{ tipo, etiqueta?, obligatorio }] (comercio/datos-cliente.rules.ts).
  datosCliente Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Conversación de WhatsApp entre un cliente (remoteJid) y el agente de un
/// usuario (dueño del número vinculado).
model Conversation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// JID de Baileys del cliente que escribe, ej "5491122334455@s.whatsapp.net".
  remoteJid String

  /// Resumen breve del cliente (quién es, qué buscó, preferencias), que el
  /// agente actualiza tras cada intercambio para "recordarlo" más allá de la
  /// ventana de mensajes recientes que se manda como contexto.
  resumen String?

  /// Nombre del cliente, preguntado una única vez al agendar el primer turno
  /// y reusado en los siguientes para no volver a pedirlo.
  nombreCliente String?

  messages Message[]
  turnos   Turno[]
  ventas   Venta[]

  etapaChat        EtapaChat?
  interesProductos InteresProducto[]

  /// Cuándo se le avisó a este cliente que el vendedor no está disponible
  /// (LAU-37). Fuera del horario de atención se avisa una vez por cierre.
  avisoFueraDeHorarioAt DateTime?

  /// Quién contesta este chat (LAU-81): "asistente" | "humana". Es el único
  /// estado del chat: lo cambian el dueño (panel o escribiendo desde su
  /// teléfono) y una derivación de pedido (LAU-27). Sólo vuelve a
  /// "asistente" con el botón del panel. Reglas en src/chats/atencion.ts.
  atencion       String    @default("asistente")
  /// Cuándo pasó a una persona y cuándo se le devolvió al asistente, con la
  /// nota que dejó el dueño (dato, nunca instrucción). El asistente lee lo
  /// que se habló entre las dos fechas al retomar.
  tomadaAt       DateTime?
  devueltaAt     DateTime?
  notaDevolucion String?

  /// Cuándo se guardó el último mensaje del chat: ordena la lista de Chats.
  /// Lo mantiene un trigger de la base sobre "Message" (migración
  /// 20261103120000_atencion_por_conversacion), así no depende de quién escriba.
  ultimoMensajeAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, remoteJid])
  @@index([userId, ultimoMensajeAt])
}

/// Un mensaje del historial de una Conversation, en el shape que espera
/// OpenRouter (compatible OpenAI): { content } | { tool_calls } |
/// { tool_call_id, content }. Se guarda tal cual para no tener que
/// transformar nada al reconstruir el historial de cada turno del loop.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// "user" | "assistant" | "tool"
  role    String
  /// Forma OpenAI ({ content, tool_calls? }). Mientras un pedido está en
  /// atención humana el asistente no corre: lo que escribe el cliente se guarda
  /// con `enAtencionHumana: true` y lo que contesta el dueño desde su teléfono
  /// como "assistant" con `humano: true`.
  content Json

  createdAt DateTime @default(now())

  /// Llave de idempotencia de un mensaje que el dueño mandó desde el panel
  /// (LAU-81): reintentar con la misma no lo manda dos veces.
  clave String?

  @@unique([conversationId, clave])
  /// El conteo de chats del mes (suscripción) filtra por rol y fecha.
  @@index([conversationId, createdAt])
}

/// Turno agendado (o cancelado) en el calendario del dueño a partir de una
/// Conversation. Permite que cancelar_turno/reprogramar_turno operen sobre
/// "el turno activo más reciente de esta conversación" sin que el modelo
/// tenga que manejar ids de Google Calendar.
model Turno {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// Id del evento en el calendario del dueño: de Google Calendar, o de la
  /// tabla Evento si `User.calendario` es "local". Conserva el nombre para no
  /// migrar datos.
  googleEventId String
  /// A nombre de quién quedó agendado el turno.
  nombreCliente String?
  /// Sólo en los turnos grupales: el nombre del tipo (de `Agent.tiposEvento`).
  /// Junta a los anotados de una misma clase (mismo dueño, tipo e inicio),
  /// que comparten `googleEventId`. null = turno individual.
  tipo          String?
  inicio        DateTime
  fin           DateTime

  /// "confirmado" | "cancelado"
  estado String @default("confirmado")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Lápida de una prueba gratis ya empezada. Sobrevive a la baja de la cuenta
/// (sin FK al User) para que borrar y volver a crear la cuenta no regale otro
/// mes: guarda sólo un HMAC de la identidad (Google, email o teléfono) y la
/// fecha de alta original, nunca el dato legible. Ver
/// api/src/subscription/prueba-consumida.ts. No se purga: si caducara, esperar
/// un mes reabriría el hueco.
model PruebaConsumida {
  id     String   @id @default(cuid())
  huella String   @unique
  inicio DateTime
}

/// Suscripción paga del dueño. La fila recién existe cuando arranca un pago:
/// el mes de prueba gratis se deriva de `User.createdAt` (ver
/// api/src/subscription/subscription.rules.ts), así que un usuario sin fila
/// está en prueba o vencido, y no hace falta backfill.
model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "pendiente" | "activa" | "pausada" | "cancelada"
  estado String @default("pendiente")

  /// "basico" | "pro" (ver PLANES en api/src/subscription/subscription.rules.ts).
  /// Las filas anteriores a los dos planes pagaron el Básico.
  plan String @default("basico")

  /// Cambio de plan en curso: el preapproval nuevo y su plan, mientras la
  /// persona no lo autorizó en Mercado Pago. La fila sigue apuntando al
  /// vigente; recién cuando el webhook confirma el nuevo se adopta y se
  /// cancela el anterior.
  mpPreapprovalPendienteId String? @unique
  planPendiente            String?

  /// Id del preapproval de Mercado Pago: es la llave con la que llega el webhook.
  mpPreapprovalId String? @unique
  /// Último `status` crudo que devolvió Mercado Pago, para diagnóstico.
  mpStatus        String?

  /// Importe mensual en la unidad menor de la moneda (centavos).
  montoCentavos Int
  moneda        String @default("ARS")

  ultimoPagoAt   DateTime?
  proximoCobroAt DateTime?
  canceladaAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Evento de la agenda local, para los usuarios con `calendario = "local"`
/// (cuentas creadas sólo con WhatsApp). Mismo contrato que un evento de
/// Google Calendar para CalendarService: resumen, inicio y fin.
model Evento {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumen String
  inicio  DateTime
  fin     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, inicio])
}

/// Código de un solo uso para entrar al panel con WhatsApp: se manda al chat
/// propio del titular. Se guarda sólo el hash.
model CodigoAcceso {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 hex del código.
  hash     String
  expiraAt DateTime
  intentos Int      @default(0)

  createdAt DateTime @default(now())

  @@index([userId])
}

/// Producto del catálogo de una cuenta de ventas, con su precio y su stock.
/// No hay variantes: un talle o un color distinto es otro producto.
///
/// `textoBusqueda`, `busqueda` y `embedding` son para el RAG del asistente
/// (comercio/busqueda.service.ts). `busqueda` y `embedding` se escriben por SQL
/// crudo — Prisma no conoce tsvector ni vector. `embedding` no tiene índice
/// HNSW a propósito (ver la migración comercio_catalogo): la búsqueda vectorial
/// es exacta sobre el catálogo de una sola cuenta.
model Producto {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Clave del producto para el dueño (su SKU): con ella se re-importa sin duplicar.
  codigo      String
  nombre      String
  descripcion String  @default("")
  categoria   String?
  /// "ARS" | "USD": la moneda de su precio. Un
  /// pedido no mezcla monedas y uno en dólares se cobra a mano (Mercado Pago
  /// cobra en pesos).
  moneda      String  @default("ARS")

  /// Precio en centavos, como `Subscription.montoCentavos`.
  precioCentavos Int
  /// Unidades en stock. Null = producto a demanda: no se controla cantidad y vale `disponible`.
  stock          Int?
  /// Switch manual "hay / no hay", que sólo cuenta cuando `stock` es null.
  disponible     Boolean @default(true)
  /// A demanda (`stock` null): en cuántos días se entrega. Con stock queda en null.
  plazoEntregaDias Int?
  /// Con stock controlado: por debajo de esto se avisa al dueño.
  stockMinimo    Int?

  /// Baja lógica: un producto borrado deja de venderse pero sus ventas
  /// guardan igual su snapshot.
  activo Boolean @default(true)

  /// Nombre, categoría, descripción y código en minúsculas y sin
  /// tildes (catalogo.rules.ts). Es la base del full-text, de los trigramas y
  /// del embedding.
  textoBusqueda String                       @default("")
  /// to_tsvector('spanish', textoBusqueda).
  busqueda      Unsupported("tsvector")?
  /// openai/text-embedding-3-small vía OpenRouter (1536 dimensiones).
  embedding     Unsupported("vector(1536)")?
  /// Hash del texto con el que se calculó `embedding`: si no coincide con el
  /// de `textoBusqueda`, el indexador lo recalcula.
  embeddingHash String?

  itemsVenta      ItemVenta[]
  intereses       InteresProducto[]
  preguntas       PreguntaChat[]
  /// El descuento propio del producto (del formulario), si tiene.
  descuento       Descuento?
  /// Hasta MAX_IMAGENES_POR_PRODUCTO fotos; la de menor `orden` es la principal
  /// (la que sale al mostrar el producto) y el resto, las de detalle.
  imagenes        ImagenProducto[]
  /// Cuotas del producto (LAU-34): { modo: "recargo", recargoPorcentaje, planes: [3, 6] }
  /// o { modo: "precios", planes: [{ cuotas, totalCentavos }] }; null = en un pago.
  /// Reglas en comercio/condiciones-pago.rules.ts.
  cuotas          Json?
  /// Lo que el asistente le pregunta al cliente al pedirlo (talle, color…):
  /// [{ texto, tipo: "opciones" | "texto", opciones, obligatoria }]; null =
  /// no pregunta nada. Reglas en comercio/preguntas-producto.rules.ts.
  preguntasPedido Json?

  /// Importación rápida (LAU-31): de dónde salió el producto, como clave
  /// estable ("ml:MLA123", "web:<hash>"). Con ella reimportar el mismo enlace
  /// no crea otro producto. Null en los cargados a mano o por planilla.
  origenId    String?
  /// El enlace tal cual se importó (sin parámetros de seguimiento).
  origenUrl   String?
  importadoAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, codigo])
  @@unique([userId, origenId])
  @@index([userId, categoria])
  @@index([busqueda], type: Gin)
  @@index([textoBusqueda(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Un descuento del comercio. El alcance sale de los campos: con `productoId`
/// es el del formulario de ese producto (uno por producto); con `categoria`,
/// una promo de esa categoría; sin ninguno, una promo de todo el catálogo. Si
/// a un producto le tocan varios, se aplica el que más le conviene al
/// cliente y nunca se suman (comercio/descuentos.rules.ts).
model Descuento {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productoId String?   @unique
  producto   Producto? @relation(fields: [productoId], references: [id], onDelete: Cascade)
  categoria  String?

  /// Nombre de la promo para el dueño ("Semana del mate"). "" en los de producto.
  nombre String @default("")
  /// "porcentaje" | "monto"
  tipo   String
  /// Porcentaje (1 a 90) o centavos, según `tipo`.
  valor  Int

  activo Boolean   @default(true)
  /// Vigencia [desde, hasta). Null = sin límite de ese lado.
  desde  DateTime?
  hasta  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, activo])
}

/// La foto de un producto, ya recomprimida por la API (comercio/imagenes.rules.ts):
/// JPEG de hasta 800 px y 150 KB, sin metadatos. Tabla aparte para que los
/// listados y la búsqueda nunca arrastren los bytes. Hasta
/// `MAX_IMAGENES_POR_PRODUCTO` por producto y `MAX_IMAGENES_POR_CUENTA` por
/// cuenta, para que la base no crezca sin techo.
model ImagenProducto {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  /// 0 = la principal; las demás, en el orden en que se muestran. Lo mantiene
  /// ImagenesService (0..n-1, sin huecos), con el producto bloqueado.
  orden      Int      @default(0)

  datos Bytes
  /// Tamaño de `datos`, para el uso de la cuenta sin leer los bytes.
  bytes Int
  ancho Int
  alto  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([productoId, orden])
}

/// Un pedido del asistente de ventas, desde que se reserva el stock hasta que
/// se paga (o vence, o se cancela). La reserva no es una fila aparte: una
/// venta `pendiente_pago` con `reservaVenceAt` en el futuro retiene sus
/// unidades (ver comercio/ventas.rules.ts). El stock se descuenta recién al
/// pasar a `pagada`.
model Venta {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// La conversación de WhatsApp de donde salió. Null si se borró.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  /// A nombre de quién. Se anonimiza a los 12 meses (retention.rules.ts).
  nombreCliente   String?
  /// Número de WhatsApp del cliente (sin '+'). Misma retención que el nombre.
  telefonoCliente String?

  /// "envio" | "retiro"; null si el comercio no hace envíos.
  entrega      String?
  /// Lo que contestó el cliente: [{ etiqueta, valor }], foto de la etiqueta
  /// al vender (como ItemVenta). Misma retención que el nombre.
  datosCliente Json?

  /// "pendiente_pago" | "pagada" | "cancelada" | "vencida"
  estado          String  @default("pendiente_pago")
  /// "mercadopago" | "manual".
  medioPago       String?
  /// "efectivo" | "cuotas" (LAU-34); null = contado, como siempre. Reglas en
  /// comercio/condiciones-pago.rules.ts.
  formaPago       String?
  /// Sólo en cuotas: cuántas.
  cuotas          Int?
  /// Sólo en cuotas: lo que se sumó al total por el plan (ya incluido en `totalCentavos`).
  recargoCentavos Int     @default(0)
  /// Envío cobrado con el pedido (LAU-102), ya incluido en `totalCentavos`; 0 si es
  /// gratis o si no va en el pedido (se coordina aparte). Sale del resolvedor, nunca del modelo.
  envioCentavos   Int     @default(0)
  /// "domicilio" | "sucursal" si el envío va en el pedido; null si no.
  envioModalidad  String?
  /// El destino con el que se cotizó ("La Rioja, CP 5300"), con los nombres del
  /// catálogo Georef: el dueño lo compara con la dirección antes de despachar.
  envioDestino    String?

  totalCentavos Int?
  moneda        String @default("ARS")

  /// Hasta cuándo retiene el stock mientras está pendiente de pago.
  reservaVenceAt DateTime?

  /// "asistente" | "humana" (LAU-27). En "humana" el asistente no contesta en
  /// ese chat mientras el pedido siga abierto.
  atencion          String    @default("asistente")
  derivadaAt        DateTime?
  /// "falta_info" | "excepcion" | "pide_persona" | "sin_reglas" | "dueno" | "otro"
  motivoDerivacion  String?
  /// Por qué, en palabras del asistente o del dueño. Misma retención que el nombre.
  detalleDerivacion String?
  /// Cuándo se le devolvió el chat al asistente, y lo que el dueño dejó anotado.
  devueltaAt        DateTime?
  notaDevolucion    String?

  /// Preferencia de Checkout Pro creada con el token del comercio.
  mpPreferenceId String?
  linkPago       String?
  /// El pago que la saldó: la llave para que el webhook sea idempotente.
  mpPaymentId    String? @unique

  pagadaAt    DateTime?
  canceladaAt DateTime?

  /// Cuándo se le recordó al cliente que la reserva del link está por
  /// vencer (conciliacion.service.ts). Se marca antes de mandarlo: una sola vez.
  recordatorioPagoAt DateTime?

  /// Se pagó cuando ya no había stock para cubrirla (la reserva venció y
  /// otro compró lo último): el dueño tiene que devolver o reponer.
  sinStockAlPagar Boolean @default(false)

  /// Salió del banco de pruebas del Home (el dueño probando su asistente):
  /// es un pedido real, pero no cuenta en el histórico ni en los totales.
  dePrueba Boolean @default(false)

  items   ItemVenta[]
  eventos EventoVenta[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([estado, reservaVenceAt])
  @@index([conversationId])
  @@index([userId, atencion])
}

/// El historial de un pedido: cada derivación y devolución, con quién lo hizo
/// y por qué.
model EventoVenta {
  id      String @id @default(cuid())
  ventaId String
  venta   Venta  @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  /// "derivacion" | "devolucion"
  tipo   String
  de     String?
  a      String?
  motivo String?
  /// "asistente" | "dueno" | "sistema" | "mercadopago"
  autor  String

  createdAt DateTime @default(now())

  @@index([ventaId, createdAt])
}

/// Renglón de una venta. Guarda una foto del producto (código, nombres,
/// precio) para que el histórico no cambie si el producto se edita o se borra.
model ItemVenta {
  id      String @id @default(cuid())
  ventaId String
  venta   Venta  @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  productoId String?
  producto   Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)

  codigo                 String
  nombreProducto         String
  /// El precio que se cobró por unidad: ya con el descuento, si hubo.
  precioUnitarioCentavos Int
  cantidad               Int
  subtotalCentavos       Int
  /// Precio de lista por unidad al momento del pedido. Null en ventas
  /// anteriores a los descuentos (ahí era igual a precioUnitarioCentavos).
  precioListaCentavos    Int?
  /// Cuánto se descontó por unidad (0 sin descuento).
  descuentoCentavos      Int     @default(0)
  /// Cómo se llamaba el descuento aplicado ("20% off", "Semana del mate").
  descuentoEtiqueta      String?
  /// Lo que contestó el cliente a las preguntas del producto, copiado al pedir:
  /// [{ pregunta, respuesta }]. Null = el producto no preguntaba nada.
  respuestas             Json?

  @@index([productoId])
  @@index([ventaId])
}

/// La cuenta de Mercado Pago de un comercio, conectada por OAuth: con su token
/// se crean los links de pago a su nombre. Los tokens van cifrados con
/// AES-256-GCM igual que el refresh token de Google y nunca salen de la API.
model CuentaMercadoPago {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// user_id de Mercado Pago (el collector de los pagos).
  mpUserId     String
  accessToken  String
  refreshToken String
  expiraAt     DateTime

  conectadaAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([mpUserId])
}

/// Aviso para el dueño: se ve en la campanita del panel y, si hay WhatsApp
/// vinculado, también le llega a su propio chat. Lo generan las ventas
/// (pagada, a cobrar), el stock (bajo, agotado) y las consultas que el
/// asistente no puede responder.
model Notificacion {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "venta_pagada" | "pedido_manual" | "stock_bajo" | "stock_agotado" |
  /// "consulta_derivada" | "mercadopago_desconectado" | "whatsapp_desconectado" |
  /// "cupo_chats"
  tipo   String
  titulo String
  cuerpo String

  /// Ruta del panel a la que lleva (ej. "/ventas?venta=…"). Nunca una URL externa.
  enlace String?

  /// Para no repetir un aviso que sigue sin leer (ej. "stock:<productoId>").
  clave String?

  leidaAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, leidaAt])
  @@index([userId, createdAt])
  @@index([userId, clave])
}

/// Sugerencia de mejora que manda el dueño desde el panel (LAU-14). Se guarda
/// siempre primero y después se copia a Linear; si Linear falla queda
/// pendiente (`enviadaAt` null) y la reintenta el barrido de MejorasService.
/// El usuario no ve en qué estado está. Reglas en mejoras/mejoras.rules.ts.
model SugerenciaMejora {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "idea" | "problema" | "otro"
  tipo  String
  /// Ya normalizado y validado: solo texto (lista blanca), sin links ni HTML.
  texto String

  /// Identificador del issue en Linear (ej. "LAU-31"). Null mientras está pendiente.
  linearIssueId String?
  /// Intentos fallidos de mandarla a Linear; el barrido deja de probar en 10.
  intentos      Int       @default(0)
  enviadaAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([enviadaAt])
}

/// Cómo puede pagar el cliente de un comercio que vende (LAU-34): el descuento
/// por pagar en efectivo y el cobro sin link (las cuotas son de cada producto).
/// Sin fila, no ofrece ninguno. Reglas en comercio/condiciones-pago.rules.ts.
model CondicionesPago {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Porcentaje de descuento pagando en efectivo; null = no hay.
  descuentoEfectivoPorcentaje Int?

  /// Cómo se cobra un pedido sin link: "transferencia" (alias + titular) u
  /// "otro_canal" (mensaje del dueño). Con cualquiera, el asistente se lo
  /// manda al cliente y el chat pasa al negocio hasta que el pedido se pague o
  /// se cancele. null = se coordina por el chat y el asistente sigue.
  cobroManual          String?
  aliasTransferencia   String?
  titularTransferencia String?
  mensajeCobroManual   String?

  updatedAt DateTime @updatedAt
}

/// Etapa de un chat de ventas para el módulo de performance (LAU-30). Una
/// fila por conversación, sin datos personales: la conversación se desliga a
/// los 12 meses (retention.rules.ts) y queda sólo el conteo. Etapas y reglas
/// en performance/etapas.rules.ts; definiciones en docs/performance.md.
model EtapaChat {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Null cuando se desligó por retención o se borró la conversación.
  conversationId String?       @unique
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  /// La más avanzada que alcanzó; nunca retrocede.
  /// "consulta" | "vio_productos" | "eligiendo" | "lista" | "pedido" | "pagado"
  etapa    String  @default("consulta")
  /// Última etapa que calculó Jev: "eligiendo" | "lista". Null si nunca se calculó.
  etapaJev String?
  /// El chat se derivó a una persona (derivar_consulta o atención humana).
  derivado Boolean @default(false)

  /// Provincia del cliente (paso de zona). Null = sin zona.
  provincia     String?
  /// "dato" | "inferida"
  origenZona    String?
  /// Cuándo se clasificaron sus preguntas (paso de preguntas); se reserva antes de llamar al modelo.
  clasificadaAt DateTime?

  /// Último mensaje del cliente: de ahí sale si está activo, estancado o abandonado.
  ultimaActividadAt DateTime @default(now())

  preguntas PreguntaChat[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, ultimaActividadAt])
  @@index([userId, createdAt])
}

/// Producto que un chat de ventas vio o pidió (LAU-30). Una fila por chat,
/// producto y tipo, así un turno descartado y rehecho no cuenta dos veces.
/// Se desliga de la conversación a los 12 meses, como EtapaChat.
model InteresProducto {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  productoId     String
  producto       Producto      @relation(fields: [productoId], references: [id], onDelete: Cascade)

  /// "vio" | "pidio"
  tipo      String
  createdAt DateTime @default(now())

  @@unique([conversationId, productoId, tipo])
  @@index([userId, createdAt])
  @@index([productoId])
}

/// Pregunta de un cliente en un chat de ventas, clasificada por el modelo
/// cuando el chat se estanca o paga (LAU-30). Cuelga de EtapaChat, así hereda
/// la zona y la cohorte aunque la conversación se desligue. Reglas en
/// performance/preguntas.rules.ts.
model PreguntaChat {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  etapaChatId String
  etapaChat   EtapaChat @relation(fields: [etapaChatId], references: [id], onDelete: Cascade)

  /// Saneada en código (sin emails, URLs ni números largos). Null pasados 90 días.
  texto      String?
  /// "precio" | "envio" | "stock" | "medidas" | "pago" | "plazos" | "local" | "otro"
  tema       String
  /// Sólo un producto que ese chat vio o pidió.
  productoId String?
  producto   Producto? @relation(fields: [productoId], references: [id], onDelete: SetNull)
  /// Si el negocio la contestó con información concreta (inferencia del modelo).
  resuelta   Boolean
  /// La etapa en la que quedó el chat cuando se clasificó.
  etapa      String
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([etapaChatId])
}

/// Módulo de envíos de un comercio (LAU-102). Si hace envíos o retiro sigue
/// en `Agent.haceEnvios` y `Agent.local.retiroEnLocal`; acá sólo lo que usa el
/// resolvedor (src/envios/envios.rules.ts). Sin fila = módulo apagado.
model ConfiguracionEnvios {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  activo    Boolean @default(false)
  /// Sólo "AR" por ahora. Explícito: no se asume un país si no se eligió.
  pais      String  @default("AR")
  /// Moneda de todas las tarifas y umbrales: "ARS" | "USD".
  moneda    String  @default("ARS")
  /// Qué hace el asistente si un destino no tiene regla: "cotizar_aparte" | "derivar".
  sinTarifa String  @default("derivar")

  updatedAt DateTime @updatedAt
}

/// Una zona de envío: dónde aplica (CoberturaZona) y qué se responde ahí.
model ZonaEnvio {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nombre String
  activa Boolean @default(true)
  /// "tarifa" | "cotizacion" | "sin_cobertura"
  estado String

  /// Modalidades que ofrece (no aplican a "sin_cobertura").
  domicilio Boolean @default(false)
  sucursal  Boolean @default(false)
  /// Null = sin precio; 0 = sin cargo, explícito.
  tarifaDomicilioCentavos Int?
  tarifaSucursalCentavos  Int?
  /// Gratis desde este subtotal de productos (inclusive). Null = nunca.
  gratisDesdeCentavos     Int?

  /// Plazos estimados en días hábiles.
  preparacionDias     Int?
  transporteDesdeDias Int?
  transporteHastaDias Int?
  /// "lun" … "dom"
  diasDespacho        String[] @default([])
  instrucciones       String?

  coberturas CoberturaZona[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Un lugar que cubre una zona. Los ids son los de Georef (src/envios/geo).
/// Un CP lleva la provincia que eligió el dueño (o la de su letra CPA) y,
/// opcionalmente, la localidad: no hay catálogo CP → localidad.
model CoberturaZona {
  id     String    @id @default(cuid())
  zonaId String
  zona   ZonaEnvio @relation(fields: [zonaId], references: [id], onDelete: Cascade)

  /// "cp" | "localidad" | "provincia" | "pais"
  nivel       String
  provinciaId String?
  localidadId String?
  /// Cuatro dígitos, sin letra ni sufijo.
  cp          String?

  @@index([zonaId])
}

/// Una consulta de envío que el asistente no pudo responder, para que el
/// dueño vea qué le falta configurar. Sin conversación, dirección ni teléfono:
/// sólo la ubicación normalizada. Se borra a los 90 días (retention.rules.ts).
model ConsultaEnvioSinResolver {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "sin_configurar" | "conflicto" | "ambigua" | "contradiccion" | "error"
  motivo      String
  provinciaId String?
  localidadId String?
  cp          String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}
