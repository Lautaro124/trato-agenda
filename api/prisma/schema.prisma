// Esquema de Trato.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // La URL de conexión vive en prisma.config.ts (Prisma 7).
}

/// Titular de una cuenta. Se entra con Google o sólo con WhatsApp: por eso
/// `googleId`, `email` y `phoneNumber` son opcionales. Un usuario sin ninguno
/// de los tres es un alta por WhatsApp que todavía no escaneó el QR, y la
/// purga diaria lo borra (ver retention.rules.ts).
model User {
  id        String  @id @default(cuid())
  googleId  String? @unique
  email     String? @unique
  name      String?
  avatarUrl String?

  /// Número de WhatsApp vinculado (sin '+'). Identifica a las cuentas creadas
  /// sólo con WhatsApp y permite entrar con un código mandado al chat propio.
  phoneNumber String? @unique

  /// "google" | "local" — dónde vive la agenda. "local" es la tabla Evento.
  /// Explícito a propósito: un usuario de Google que perdió el refresh token
  /// no tiene que pasar en silencio a la agenda local.
  calendario String @default("google")

  /// Contraseña para entrar con número de WhatsApp (scrypt, ver
  /// auth/password.ts). Nunca en claro. Las cuentas de Google no la usan.
  passwordHash String?

  /// Refresh token de Google cifrado con AES-256-GCM. Nunca se expone por la API.
  googleRefreshToken String?

  whatsappSession WhatsappSession?
  agent           Agent?
  conversaciones  Conversation[]
  suscripcion     Subscription?
  eventos         Evento[]
  codigosAcceso   CodigoAcceso[]
  productos       Producto[]
  descuentos      Descuento[]
  imagenesProducto ImagenProducto[]
  imagenesVariante ImagenVariante[]
  ventas          Venta[]
  cuentaMercadoPago CuentaMercadoPago?
  notificaciones  Notificacion[]
  sugerencias     SugerenciaMejora[]
  insumos          Insumo[]
  configCotizacion ConfigCotizacion?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Sesión de WhatsApp (Baileys) vinculada a un usuario. Un usuario vincula un
/// único número por ahora, de ahí el 1:1.
model WhatsappSession {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// `{ creds }` de Baileys serializado con BufferJSON y cifrado con
  /// AES-256-GCM (token-crypto.ts), igual que googleRefreshToken. Las claves
  /// de Signal viven aparte, una por fila en WhatsappClave. Una fila de antes
  /// de LAU-18 trae `{ creds, keys }` entero: se parte en filas la primera vez
  /// que se carga (whatsapp-auth-state.ts).
  authState String

  claves WhatsappClave[]

  /// Número vinculado (sin '+'), recién disponible cuando abre la conexión.
  phoneNumber String?

  /// Espejo de creds.registered: si es true, al reiniciar la API se reconecta
  /// esta sesión sin pedir un QR nuevo.
  registered Boolean @default(false)

  linkedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Una clave de Signal de una sesión de WhatsApp (pre-keys, sesiones con cada
/// contacto, sender keys, app-state…). Antes iban todas en un solo blob que se
/// reescribía entero en cada mensaje; así cada `keys.set` toca sólo las filas
/// que cambiaron. Cuelga de la sesión y no del usuario: todo lo que borra la
/// sesión (desvincular, un QR vencido, la baja de la cuenta) se lleva sus claves.
model WhatsappClave {
  userId String
  sesion WhatsappSession @relation(fields: [userId], references: [userId], onDelete: Cascade)

  /// Tipo de clave de Baileys (`SignalDataTypeMap`): "pre-key", "session"…
  categoria String
  /// Id de la clave dentro de su categoría.
  clave     String
  /// El valor serializado con BufferJSON y cifrado con AES-256-GCM, uno por uno.
  valor     String

  updatedAt DateTime @updatedAt

  @@id([userId, categoria, clave])
}

/// Config del agente personalizado de un usuario, generada por el meta-agente
/// (api/src/agents) a partir de los cinco datos que carga en /contanos. Un
/// usuario tiene un único agente; volver a generar lo pisa.
model Agent {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "comercio" | "consultorio" | "reuniones" | "visitas" | "personal" | "otro"
  tipoUso String

  /// "agenda" | "ventas" — qué hace el asistente, y con eso qué grafo lo
  /// atiende. Es el discriminador y no `tipoUso`: hay agentes guardados con
  /// `tipoUso: 'comercio'` que son bots de turnos y tienen que seguir siéndolo.
  tipoAsistente String @default("agenda")

  /// Ya no la escribe el usuario: la arma el backend con los campos de abajo
  /// (construirDescripcion en agents.service.ts) y es lo que ve el meta-agente.
  descripcion String

  /// "persona" | "negocio" — define cómo se presenta el asistente.
  tipoTitular String @default("negocio")

  /// Nombre de la persona o del negocio que atiende.
  nombreTitular String @default("")

  /// Nombre con el que el asistente saluda por WhatsApp.
  nombreBot String @default("Tati")

  /// Franja horaria de atención, "HH:MM" en America/Argentina/Buenos_Aires.
  /// El runtime no agenda nada fuera de esta franja.
  horaDesde String @default("09:00")
  horaHasta String @default("18:00")

  /// [{ nombre: string, duracionMin: number, precio?: number, capacidad?: number,
  /// horarios?: [{ dia: "lun"…"dom", hora: "HH:MM" }] }] — tipos de turno que toma.
  /// Con `capacidad` es un turno grupal: varias personas en sus horarios fijos
  /// (api/src/agents/turnos-grupales.ts).
  tiposEvento Json @default("[]")

  /// System prompt generado, usado por el runtime conversacional (api/src/conversation).
  systemPrompt String

  /// Subconjunto de agent-catalog.ts que el agente tiene habilitado.
  allowedActions String[]

  /// Mensajes que el dueño escribió a mano en /asistente:
  /// { [clave]: { modo: "auto" | "propio", texto: string } }. Las claves y sus
  /// datos están en src/agents/mensajes.rules.ts; lo que falta queda en "auto".
  mensajes Json @default("{}")

  /// Dónde se atiende. Ventas: el local a la calle del comercio, si tiene.
  /// { tieneLocal, direccion?, enlaceUbicacion?, horarios: [{ dia, desde, hasta }], retiroEnLocal }.
  /// Agenda (LAU-17): { tieneLocal, lugar: "local" | "casa", direccion, enlaceUbicacion? }
  /// (tieneLocal false = sin lugar fijo). Null = nunca lo cargó (el asistente
  /// deriva esas consultas al dueño). La forma y sus reglas están en src/agents/local.ts.
  local Json?

  /// Modelo de OpenRouter usado para generar esta config. Null si se generó
  /// con la plantilla determinista (ver `templateVersion`); se conserva tal
  /// cual en los agentes generados por IA antes de este campo existir.
  model String?

  /// Versión de la plantilla determinista (agent-template.ts) que generó
  /// esta config. Null en agentes generados por IA antes de este campo.
  templateVersion Int?

  /// Sólo ventas: el comercio hace envíos. El asistente pregunta "¿envío o
  /// retiro?" y pide los datos de `datosCliente` sólo si es con envío.
  haceEnvios Boolean @default(false)

  /// Sólo ventas: qué datos le pide el asistente al cliente antes de crear el
  /// pedido. [{ tipo, etiqueta?, obligatorio }] (comercio/datos-cliente.rules.ts).
  datosCliente Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Conversación de WhatsApp entre un cliente (remoteJid) y el agente de un
/// usuario (dueño del número vinculado).
model Conversation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// JID de Baileys del cliente que escribe, ej "5491122334455@s.whatsapp.net".
  remoteJid String

  /// Resumen breve del cliente (quién es, qué buscó, preferencias), que el
  /// agente actualiza tras cada intercambio para "recordarlo" más allá de la
  /// ventana de mensajes recientes que se manda como contexto.
  resumen String?

  /// Nombre del cliente, preguntado una única vez al agendar el primer turno
  /// y reusado en los siguientes para no volver a pedirlo.
  nombreCliente String?

  messages Message[]
  turnos   Turno[]
  ventas   Venta[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, remoteJid])
}

/// Un mensaje del historial de una Conversation, en el shape que espera
/// OpenRouter (compatible OpenAI): { content } | { tool_calls } |
/// { tool_call_id, content }. Se guarda tal cual para no tener que
/// transformar nada al reconstruir el historial de cada turno del loop.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// "user" | "assistant" | "tool"
  role    String
  /// Forma OpenAI ({ content, tool_calls? }). Mientras un pedido está en
  /// atención humana el asistente no corre: lo que escribe el cliente se guarda
  /// con `enAtencionHumana: true` y lo que contesta el dueño desde su teléfono
  /// como "assistant" con `humano: true`.
  content Json

  createdAt DateTime @default(now())

  /// El conteo de chats del mes (suscripción) filtra por rol y fecha.
  @@index([conversationId, createdAt])
}

/// Turno agendado (o cancelado) en el calendario del dueño a partir de una
/// Conversation. Permite que cancelar_turno/reprogramar_turno operen sobre
/// "el turno activo más reciente de esta conversación" sin que el modelo
/// tenga que manejar ids de Google Calendar.
model Turno {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// Id del evento en el calendario del dueño: de Google Calendar, o de la
  /// tabla Evento si `User.calendario` es "local". Conserva el nombre para no
  /// migrar datos.
  googleEventId String
  /// A nombre de quién quedó agendado el turno.
  nombreCliente String?
  /// Sólo en los turnos grupales: el nombre del tipo (de `Agent.tiposEvento`).
  /// Junta a los anotados de una misma clase (mismo dueño, tipo e inicio),
  /// que comparten `googleEventId`. null = turno individual.
  tipo          String?
  inicio        DateTime
  fin           DateTime

  /// "confirmado" | "cancelado"
  estado String @default("confirmado")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Suscripción paga del dueño. La fila recién existe cuando arranca un pago:
/// el mes de prueba gratis se deriva de `User.createdAt` (ver
/// api/src/subscription/subscription.rules.ts), así que un usuario sin fila
/// está en prueba o vencido, y no hace falta backfill.
model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "pendiente" | "activa" | "pausada" | "cancelada"
  estado String @default("pendiente")

  /// "basico" | "pro" (ver PLANES en api/src/subscription/subscription.rules.ts).
  /// Las filas anteriores a los dos planes pagaron el Básico.
  plan String @default("basico")

  /// Cambio de plan en curso: el preapproval nuevo y su plan, mientras la
  /// persona no lo autorizó en Mercado Pago. La fila sigue apuntando al
  /// vigente; recién cuando el webhook confirma el nuevo se adopta y se
  /// cancela el anterior.
  mpPreapprovalPendienteId String? @unique
  planPendiente            String?

  /// Id del preapproval de Mercado Pago: es la llave con la que llega el webhook.
  mpPreapprovalId String? @unique
  /// Último `status` crudo que devolvió Mercado Pago, para diagnóstico.
  mpStatus        String?

  /// Importe mensual en la unidad menor de la moneda (centavos).
  montoCentavos Int
  moneda        String @default("ARS")

  ultimoPagoAt   DateTime?
  proximoCobroAt DateTime?
  canceladaAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Evento de la agenda local, para los usuarios con `calendario = "local"`
/// (cuentas creadas sólo con WhatsApp). Mismo contrato que un evento de
/// Google Calendar para CalendarService: resumen, inicio y fin.
model Evento {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  resumen String
  inicio  DateTime
  fin     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, inicio])
}

/// Código de un solo uso para entrar al panel con WhatsApp: se manda al chat
/// propio del titular. Se guarda sólo el hash.
model CodigoAcceso {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 hex del código.
  hash     String
  expiraAt DateTime
  intentos Int      @default(0)

  createdAt DateTime @default(now())

  @@index([userId])
}

/// Producto del catálogo de una cuenta de ventas. El precio y el stock no
/// viven acá sino en sus variantes: todo producto tiene al menos una (la
/// "única", con nombre vacío, si no tiene talles ni colores).
///
/// `textoBusqueda`, `busqueda` y `embedding` son para el RAG del asistente
/// (comercio/busqueda.service.ts). `busqueda` y `embedding` se escriben por SQL
/// crudo — Prisma no conoce tsvector ni vector. `embedding` no tiene índice
/// HNSW a propósito (ver la migración comercio_catalogo): la búsqueda vectorial
/// es exacta sobre el catálogo de una sola cuenta.
model Producto {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Clave del producto para el dueño: con ella se re-importa sin duplicar.
  codigo      String
  nombre      String
  descripcion String  @default("")
  categoria   String?

  /// Baja lógica: un producto borrado deja de venderse pero sus ventas
  /// guardan igual su snapshot.
  activo Boolean @default(true)

  /// Nombre, categoría, descripción, códigos y variantes en minúsculas y sin
  /// tildes (catalogo.rules.ts). Es la base del full-text, de los trigramas y
  /// del embedding.
  textoBusqueda String @default("")
  /// to_tsvector('spanish', textoBusqueda).
  busqueda      Unsupported("tsvector")?
  /// openai/text-embedding-3-small vía OpenRouter (1536 dimensiones).
  embedding     Unsupported("vector(1536)")?
  /// Hash del texto con el que se calculó `embedding`: si no coincide con el
  /// de `textoBusqueda`, el indexador lo recalcula.
  embeddingHash String?

  variantes Variante[]
  /// El descuento propio del producto (del formulario), si tiene.
  descuento Descuento?
  /// La foto que el asistente le manda al cliente cuando la pide (una sola).
  imagen    ImagenProducto?
  /// Producto a medida (LAU-22): las preguntas que el asistente le hace al
  /// cliente para presupuestar, `{ preguntas: [{ texto, sobre: 'tiene' |
  /// 'solicita', opciones, textoLibre, obligatoria }] }`, en el orden en que
  /// las hace; `{ preguntas: [] }` es a medida sin preguntas propias. Null =
  /// no se hace a medida. La forma y sus reglas están en
  /// comercio/solicitud.rules.ts.
  solicitud Json?
  /// Precio "desde" opcional de un producto a medida, que no tiene stock: el
  /// precio real sale de la cotización. Null en los de stock.
  precioReferenciaCentavos Int?
  /// Con qué materiales se hace un producto a medida: el asistente ofrece
  /// sólo esos. Vacío en los de stock y cuando el dueño no los cargó.
  materiales String[] @default([])
  /// Producto a medida (LAU-26): cómo se cotiza solo. `{ renglones: [{ insumoId,
  /// cantidad: "<fórmula>", cuando? }], extras: [{ nombre, modo, valor, formula?,
  /// cuando? }] }`; las fórmulas usan las preguntas de número de `solicitud`.
  /// Null = no tiene receta (lo cotiza el dueño). Reglas en comercio/costos.rules.ts.
  receta Json?
  /// "manual" (lo cotiza el dueño) | "revision" (el asistente lo arma y el dueño
  /// lo aprueba) | "automatica" (el asistente cotiza y lo manda).
  politicaCotizacion String @default("manual")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, codigo])
  @@index([userId, categoria])
  @@index([busqueda], type: Gin)
  @@index([textoBusqueda(ops: raw("gin_trgm_ops"))], type: Gin)
}

/// Variante vendible de un producto (talle, color, sabor…), con su precio y su
/// stock. Un producto sin variantes tiene una sola, con `nombre` vacío.
model Variante {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  sku    String
  /// "" para la variante única de un producto sin variantes.
  nombre String @default("")

  /// Precio en centavos, como `Subscription.montoCentavos`.
  precioCentavos Int

  /// Unidades en stock. Null = el dueño no controla cantidad y vale `disponible`.
  stock        Int?
  /// Switch manual "hay / no hay", que sólo cuenta cuando `stock` es null.
  disponible   Boolean @default(true)
  /// Con stock controlado: por debajo de esto se avisa al dueño.
  stockMinimo  Int?

  activo Boolean @default(true)

  itemsVenta ItemVenta[]
  /// La foto propia de una variante fija de un producto a medida, si tiene.
  imagen     ImagenVariante?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productoId, sku])
}

/// Un descuento del comercio. El alcance sale de los campos: con `productoId`
/// es el del formulario de ese producto (uno por producto); con `categoria`,
/// una promo de esa categoría; sin ninguno, una promo de todo el catálogo. Si
/// a una variante le tocan varios, se aplica el que más le conviene al
/// cliente y nunca se suman (comercio/descuentos.rules.ts).
model Descuento {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productoId String?   @unique
  producto   Producto? @relation(fields: [productoId], references: [id], onDelete: Cascade)
  categoria  String?

  /// Nombre de la promo para el dueño ("Semana del mate"). "" en los de producto.
  nombre String @default("")
  /// "porcentaje" | "monto"
  tipo   String
  /// Porcentaje (1 a 90) o centavos, según `tipo`.
  valor  Int

  activo Boolean   @default(true)
  /// Vigencia [desde, hasta). Null = sin límite de ese lado.
  desde  DateTime?
  hasta  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, activo])
}

/// La foto de un producto, ya recomprimida por la API (comercio/imagenes.rules.ts):
/// JPEG de hasta 800 px y 150 KB, sin metadatos. Tabla aparte para que los
/// listados y la búsqueda nunca arrastren los bytes. Una por producto y hasta
/// `MAX_IMAGENES_POR_CUENTA` por cuenta, para que la base no crezca sin techo.
model ImagenProducto {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  productoId String   @unique
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  datos Bytes
  /// Tamaño de `datos`, para el uso de la cuenta sin leer los bytes.
  bytes Int
  ancho Int
  alto  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// La foto de una variante fija de un producto a medida: el asistente la manda
/// cuando el cliente elige esa versión. Mismo formato y mismo cupo por cuenta
/// que ImagenProducto (comercio/imagenes.rules.ts); aparte para no tocar el
/// producto único de esa tabla.
model ImagenVariante {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  varianteId String   @unique
  variante   Variante @relation(fields: [varianteId], references: [id], onDelete: Cascade)

  datos Bytes
  bytes Int
  ancho Int
  alto  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Un pedido del asistente de ventas, desde que se reserva el stock hasta que
/// se paga (o vence, o se cancela). La reserva no es una fila aparte: una
/// venta `pendiente_pago` con `reservaVenceAt` en el futuro retiene sus
/// unidades (ver comercio/ventas.rules.ts). El stock se descuenta recién al
/// pasar a `pagada`.
model Venta {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// La conversación de WhatsApp de donde salió. Null si se borró.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  /// A nombre de quién. Se anonimiza a los 12 meses (retention.rules.ts).
  nombreCliente   String?
  /// Número de WhatsApp del cliente (sin '+'). Misma retención que el nombre.
  telefonoCliente String?

  /// "envio" | "retiro"; null si el comercio no hace envíos.
  entrega      String?
  /// Lo que contestó el cliente: [{ etiqueta, valor }], foto de la etiqueta
  /// al vender (como ItemVenta). Misma retención que el nombre.
  datosCliente Json?

  /// "stock" (productos del catálogo con variantes) | "a_medida" (una
  /// solicitud que se cotiza: LAU-24/26/27). Las reglas de los a medida están
  /// en comercio/pedido-a-medida.rules.ts.
  tipo String @default("stock")

  /// "solicitado" | "a_cotizar" | "cotizado" (sólo a medida) | "pendiente_pago"
  /// | "pagada" | "cancelada" | "vencida"
  estado    String @default("pendiente_pago")
  /// "mercadopago" | "manual". Null en un a medida que todavía no se cobra.
  medioPago String?

  /// Null en un a medida sin cotizar: nunca un cero inventado.
  totalCentavos Int?
  moneda        String @default("ARS")

  /// Hasta cuándo retiene el stock mientras está pendiente de pago. En un a
  /// medida es hasta cuándo vale el link (o el cobro a coordinar); null
  /// mientras no se cobra.
  reservaVenceAt DateTime?

  /// Sólo a medida: la foto de lo que pidió el cliente, `{ productoId,
  /// nombreProducto, respuestas: [{ pregunta, respuesta }], resumen }`. Se
  /// anonimiza el resumen a los 12 meses, como el nombre.
  solicitud Json?

  /// "asistente" | "humana" (LAU-27). En "humana" el asistente no contesta en
  /// ese chat mientras el pedido siga abierto.
  atencion          String    @default("asistente")
  derivadaAt        DateTime?
  /// "falta_info" | "excepcion" | "pide_persona" | "sin_reglas" | "dueno" | "otro"
  motivoDerivacion  String?
  /// Por qué, en palabras del asistente o del dueño. Misma retención que el nombre.
  detalleDerivacion String?
  /// Cuándo se le devolvió el chat al asistente, y lo que el dueño dejó anotado.
  devueltaAt        DateTime?
  notaDevolucion    String?

  /// Preferencia de Checkout Pro creada con el token del comercio.
  mpPreferenceId String?
  linkPago       String?
  /// El pago que la saldó: la llave para que el webhook sea idempotente.
  mpPaymentId    String? @unique

  pagadaAt    DateTime?
  canceladaAt DateTime?

  /// Se pagó cuando ya no había stock para cubrirla (la reserva venció y
  /// otro compró lo último): el dueño tiene que devolver o reponer.
  sinStockAlPagar Boolean @default(false)

  /// Salió del banco de pruebas del Home (el dueño probando su asistente):
  /// es un pedido real, pero no cuenta en el histórico ni en los totales.
  dePrueba Boolean @default(false)

  items        ItemVenta[]
  presupuestos Presupuesto[]
  eventos      EventoVenta[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([estado, reservaVenceAt])
  @@index([conversationId])
  @@index([userId, atencion])
}

/// Un presupuesto de un pedido a medida. Cada cambio es una versión nueva: la
/// anterior queda "reemplazado", y la que se cobra es la única "enviado".
/// Reglas en comercio/presupuesto.rules.ts.
model Presupuesto {
  id      String @id @default(cuid())
  ventaId String
  venta   Venta  @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  version Int
  /// "asistente" (lo calculó la receta) | "dueno" (lo armó o editó a mano)
  origen  String
  /// "borrador" | "enviado" | "reemplazado" | "descartado"
  estado  String @default("borrador")

  /// [{ concepto, tipo: material|proceso|mano_obra|extra|otro, cantidad,
  /// unidad, precioUnitarioCentavos, subtotalCentavos }], foto del momento.
  renglones     Json
  totalCentavos Int
  moneda        String  @default("ARS")
  /// Si es estimativo (el precio final puede cambiar) o definitivo.
  estimativo    Boolean @default(false)
  /// Si el cliente ve los renglones o sólo el total.
  detalleAlCliente Boolean @default(false)
  /// Lo que el dueño le agrega al cliente (plazo, condiciones). Nunca lo inventa el asistente.
  nota          String?
  /// Fase 2: las respuestas y valores con que se calculó.
  datos         Json?

  enviadoAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([ventaId, version])
}

/// El historial de un pedido: cada cambio de estado, derivación, devolución,
/// presupuesto y cobro, con quién lo hizo y por qué.
model EventoVenta {
  id      String @id @default(cuid())
  ventaId String
  venta   Venta  @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  /// "estado" | "derivacion" | "devolucion" | "presupuesto" | "cobro"
  tipo   String
  de     String?
  a      String?
  motivo String?
  /// "asistente" | "dueno" | "sistema" | "mercadopago"
  autor  String

  createdAt DateTime @default(now())

  @@index([ventaId, createdAt])
}

/// Renglón de una venta. Guarda una foto del producto (código, nombres,
/// precio) para que el histórico no cambie si el producto se edita o se borra.
model ItemVenta {
  id      String @id @default(cuid())
  ventaId String
  venta   Venta  @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  varianteId String?
  variante   Variante? @relation(fields: [varianteId], references: [id], onDelete: SetNull)

  codigo                 String
  nombreProducto         String
  nombreVariante         String @default("")
  /// El precio que se cobró por unidad: ya con el descuento, si hubo.
  precioUnitarioCentavos Int
  cantidad               Int
  subtotalCentavos       Int
  /// Precio de lista por unidad al momento del pedido. Null en ventas
  /// anteriores a los descuentos (ahí era igual a precioUnitarioCentavos).
  precioListaCentavos    Int?
  /// Cuánto se descontó por unidad (0 sin descuento).
  descuentoCentavos      Int     @default(0)
  /// Cómo se llamaba el descuento aplicado ("20% off", "Semana del mate").
  descuentoEtiqueta      String?

  @@index([varianteId])
  @@index([ventaId])
}

/// La cuenta de Mercado Pago de un comercio, conectada por OAuth: con su token
/// se crean los links de pago a su nombre. Los tokens van cifrados con
/// AES-256-GCM igual que el refresh token de Google y nunca salen de la API.
model CuentaMercadoPago {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// user_id de Mercado Pago (el collector de los pagos).
  mpUserId     String
  accessToken  String
  refreshToken String
  expiraAt     DateTime

  conectadaAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([mpUserId])
}

/// Aviso para el dueño: se ve en la campanita del panel y, si hay WhatsApp
/// vinculado, también le llega a su propio chat. Lo generan las ventas
/// (pagada, a cobrar), el stock (bajo, agotado) y las consultas que el
/// asistente no puede responder.
model Notificacion {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "venta_pagada" | "pedido_manual" | "stock_bajo" | "stock_agotado" |
  /// "consulta_derivada" | "mercadopago_desconectado" | "whatsapp_desconectado" |
  /// "solicitud_a_cotizar" | "presupuesto_a_revisar" | "pedido_derivado" | "presupuesto_aceptado" | "cupo_chats"
  tipo   String
  titulo String
  cuerpo String

  /// Ruta del panel a la que lleva (ej. "/ventas?venta=…"). Nunca una URL externa.
  enlace String?

  /// Para no repetir un aviso que sigue sin leer (ej. "stock:<varianteId>").
  clave String?

  leidaAt   DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, leidaAt])
  @@index([userId, createdAt])
  @@index([userId, clave])
}

/// Sugerencia de mejora que manda el dueño desde el panel (LAU-14). Se guarda
/// siempre primero y después se copia a Linear; si Linear falla queda
/// pendiente (`enviadaAt` null) y la reintenta el barrido de MejorasService.
/// El usuario no ve en qué estado está. Reglas en mejoras/mejoras.rules.ts.
model SugerenciaMejora {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "idea" | "problema" | "otro"
  tipo  String
  /// Ya normalizado y validado: solo texto (lista blanca), sin links ni HTML.
  texto String

  /// Identificador del issue en Linear (ej. "LAU-31"). Null mientras está pendiente.
  linearIssueId String?
  /// Intentos fallidos de mandarla a Linear; el barrido deja de probar en 10.
  intentos      Int       @default(0)
  enviadaAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([enviadaAt])
}

/// Lo que cuesta hacer algo en un comercio a pedido (LAU-26), por unidad:
/// materiales, fabricación y máquinas, mano de obra. Las recetas de los
/// productos lo referencian por id, así que no se borra: `activo = false`.
model Insumo {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "material" | "proceso" | "mano_obra"
  tipo          String
  nombre        String
  /// "unidad" | "m" | "m2" | "m3" | "cm" | "cm2" | "litro" | "kg" | "g" | "hora" | "minuto"
  unidad        String
  costoCentavos Int
  activo        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, tipo, nombre])
}

/// Cómo cotiza el asistente de un comercio a pedido (LAU-26): extras que se
/// suman a toda cotización, redondeo, si es estimativo, vigencia y cuánto
/// detalle ve el cliente. Sin fila, lo de costos.rules.ts CONFIG_POR_DEFECTO.
model ConfigCotizacion {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// [{ nombre, modo: "fijo" | "porcentaje", valor }]
  extras            Json    @default("[]")
  redondeoCentavos  Int     @default(0)
  estimativo        Boolean @default(true)
  /// Null = el presupuesto no dice hasta cuándo vale.
  vigenciaDias      Int?
  /// "total" | "detallado"
  desgloseAlCliente String  @default("total")

  updatedAt DateTime @updatedAt
}
