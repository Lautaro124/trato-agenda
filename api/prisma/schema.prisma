// Esquema de Trato Agenda: por ahora sólo el usuario que entra con Google.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // La URL de conexión vive en prisma.config.ts (Prisma 7).
}

model User {
  id        String  @id @default(cuid())
  googleId  String  @unique
  email     String  @unique
  name      String?
  avatarUrl String?

  /// Refresh token de Google cifrado con AES-256-GCM. Nunca se expone por la API.
  googleRefreshToken String?

  whatsappSession WhatsappSession?
  agent           Agent?
  conversaciones  Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Sesión de WhatsApp (Baileys) vinculada a un usuario. Un usuario vincula un
/// único número por ahora, de ahí el 1:1.
model WhatsappSession {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// { creds, keys } de Baileys serializado con BufferJSON y cifrado entero
  /// con AES-256-GCM (token-crypto.ts), igual que googleRefreshToken.
  authState String

  /// Número vinculado (sin '+'), recién disponible cuando abre la conexión.
  phoneNumber String?

  /// Espejo de creds.registered: si es true, al reiniciar la API se reconecta
  /// esta sesión sin pedir un QR nuevo.
  registered Boolean @default(false)

  linkedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// Config del agente personalizado de un usuario, generada por el meta-agente
/// (api/src/agents) a partir de los cinco datos que carga en /contanos. Un
/// usuario tiene un único agente; volver a generar lo pisa.
model Agent {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "comercio" | "consultorio" | "reuniones" | "visitas" | "personal" | "otro"
  tipoUso String

  /// Ya no la escribe el usuario: la arma el backend con los campos de abajo
  /// (construirDescripcion en agents.service.ts) y es lo que ve el meta-agente.
  descripcion String

  /// "persona" | "negocio" — define cómo se presenta el asistente.
  tipoTitular String @default("negocio")

  /// Nombre de la persona o del negocio que atiende.
  nombreTitular String @default("")

  /// Nombre con el que el asistente saluda por WhatsApp.
  nombreBot String @default("Tati")

  /// Franja horaria de atención, "HH:MM" en America/Argentina/Buenos_Aires.
  /// El runtime no agenda nada fuera de esta franja.
  horaDesde String @default("09:00")
  horaHasta String @default("18:00")

  /// [{ nombre: string, duracionMin: number }] — tipos de turno que toma.
  tiposEvento Json @default("[]")

  /// System prompt generado, usado por el runtime conversacional (api/src/conversation).
  systemPrompt String

  /// Subconjunto de agent-catalog.ts que el agente tiene habilitado.
  allowedActions String[]

  /// Modelo de OpenRouter usado para generar esta config.
  model String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Conversación de WhatsApp entre un cliente (remoteJid) y el agente de un
/// usuario (dueño del número vinculado).
model Conversation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// JID de Baileys del cliente que escribe, ej "5491122334455@s.whatsapp.net".
  remoteJid String

  /// Resumen breve del cliente (quién es, qué buscó, preferencias), que el
  /// agente actualiza tras cada intercambio para "recordarlo" más allá de la
  /// ventana de mensajes recientes que se manda como contexto.
  resumen String?

  /// Nombre del cliente, preguntado una única vez al agendar el primer turno
  /// y reusado en los siguientes para no volver a pedirlo.
  nombreCliente String?

  messages Message[]
  turnos   Turno[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, remoteJid])
}

/// Un mensaje del historial de una Conversation, en el shape que espera
/// OpenRouter (compatible OpenAI): { content } | { tool_calls } |
/// { tool_call_id, content }. Se guarda tal cual para no tener que
/// transformar nada al reconstruir el historial de cada turno del loop.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// "user" | "assistant" | "tool"
  role    String
  content Json

  createdAt DateTime @default(now())
}

/// Turno agendado (o cancelado) en Google Calendar a partir de una
/// Conversation. Permite que cancelar_turno/reprogramar_turno operen sobre
/// "el turno activo más reciente de esta conversación" sin que el modelo
/// tenga que manejar ids de Google Calendar.
model Turno {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  googleEventId String
  /// A nombre de quién quedó agendado el turno.
  nombreCliente String?
  inicio        DateTime
  fin           DateTime

  /// "confirmado" | "cancelado"
  estado String @default("confirmado")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
